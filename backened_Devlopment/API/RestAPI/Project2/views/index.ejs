<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <h1>Quora Post</h1>
    <% for (let post of posts) { %>
  <div class="post">
    <h3>@<%= post.username %></h3>
    <h3><%= post.say %></h3>
     <h3><%= post.id %></h3>
    <a href="http://localhost:8080/posts/<%= post.id %>">see in detail</a><br><br>
    <a href="http://localhost:8080/posts/<%= post.id %>/edit">Edit</a><br><br>
    <form method="POST" action="/posts/<%= post.id %>?_method=DELETE">
      <button>Delete</button>
    </form>
  </div>
<% } %>
  <br>
  <a href="http://localhost:8080/posts/new" class="hii">click here to go back to new page</a>
</body>
</html>